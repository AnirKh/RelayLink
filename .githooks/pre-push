#!/bin/sh
#
# pre-push — the full suite, including the server integration tests (~45s)
#
# Pushing is what deploys: GitHub Pages republishes at once, and the Pi
# follows once GitHub's own run of the tests has passed. This is the last
# point at which a failure costs nothing.
#
# Bypass once with:  git push --no-verify
#

. "$(dirname "$0")/quietly.sh"

if ! quietly test pre-push; then
  echo ""
  echo "pre-push: tests failed — not pushing."
  echo "          Pushing republishes GitHub Pages at once, so this would"
  echo "          have gone straight to users."
  exit 1
fi
